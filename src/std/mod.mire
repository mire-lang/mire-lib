module std

// The stream submodules. Loading the parent pulls in all three, so a program
// that only wants the flat names does not have to know they exist.
load mire::std::out
load mire::std::err
load mire::std::in

// Standard input, output and error.
//
// The three streams are the substrate every other part of the standard library
// sits on: mire::str formatting ends up on stdout, macros::panic and the
// runtime's own diagnostics end up on stderr, and a program that reads its
// arguments from a pipe reads stdin. They are exposed as a module rather than
// left to each library to reach for libc, so there is one definition of what
// "write a line" means and one place where buffering and flushing are decided.
//
// Two ways in, deliberately:
//
//   load mire::std::out    explicit, for code that names the stream it means
//   load mire::std         flat, for code that does not care and wants out::print
//
// The flat names are the same functions, not copies, so a program can mix the two
// styles during a migration without the two forms drifting apart.

load mire::aux::pal

// ── out ────────────────────────────────────────────────────────────────────
pub fn print: (s :&str) :i64 { return out::print(s) }
pub fn println: (s :&str) :i64 { return out::println(s) }
pub fn print_i64: (value :i64) :i64 { return out::print_i64(value) }
pub fn print_i64_no_newline: (value :i64) :i64 { return out::print_i64_no_newline(value) }
pub fn print_f64: (value :f64) :i64 { return out::print_f64(value) }
pub fn print_f64_no_newline: (value :f64) :i64 { return out::print_f64_no_newline(value) }

// ── err ────────────────────────────────────────────────────────────────────
pub fn eprint: (s :&str) :i64 { return err::print(s) }
pub fn eprintln: (s :&str) :i64 { return err::println(s) }
pub fn eprint_i64: (value :i64) :i64 { return err::print_i64(value) }
pub fn eprint_i64_no_newline: (value :i64) :i64 { return err::print_i64_no_newline(value) }
pub fn eprint_f64: (value :f64) :i64 { return err::print_f64(value) }
pub fn eprint_f64_no_newline: (value :f64) :i64 { return err::print_f64_no_newline(value) }

// ── in ─────────────────────────────────────────────────────────────────────
pub fn read_line: () :str { return in::line() }
pub fn read_bytes: (count :i64) :str { return in::bytes(count) }
pub fn read_all: () :str { return in::all() }
pub fn read_byte: () :i64 { return in::byte() }
pub fn available: () :i64 { return in::available() }
pub fn is_tty: () :bool { return in::is_tty() }

// ── both ───────────────────────────────────────────────────────────────────

// Flush both output streams. Returns 0 when both flushed cleanly, -1 otherwise.
// Exits run this for you; it is here for a program that forks or execs and
// needs its own output on disk before the child starts.
pub fn flush: () :i64 {
    return pal::io_flush(pal::SEL_OUT) + pal::io_flush(pal::SEL_ERR)
}