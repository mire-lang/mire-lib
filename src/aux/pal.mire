// PAL (Platform Abstraction Layer) bindings for Mire
// Direct bindings to PAL C functions, replacing rt_* runtime calls.
// This module provides the low-level PAL bindings that the stdlib uses
// instead of calling into the C runtime (rt_* functions).

module pal

// ── I/O ────────────────────────────────────────────────────────────────────

// Stream selectors (match C runtime expectations)
pub const SEL_OUT: i64 = 1
pub const SEL_ERR: i64 = 2
pub const SEL_IN: i64 = 3

// Write bytes to a stream. Returns bytes written, or -1 on error.
extern fn io_write: (selector: i64, data: &str) :i64 lib "pal"

// Write up to `count` bytes from `data`. Returns bytes written.
extern fn io_write_n: (selector: i64, data: &str, count: i64) :i64 lib "pal"

// Write a line (data + newline) atomically.
extern fn io_write_line: (selector: i64, data: &str) :i64 lib "pal"

// Write an integer, optionally followed by newline.
extern fn io_write_i64: (selector: i64, value: i64, newline: i64) :i64 lib "pal"

// Write a float, optionally followed by newline.
extern fn io_write_f64: (selector: i64, value: f64, newline: i64) :i64 lib "pal"

// Flush a stream. Returns 0 on success.
extern fn io_flush: (selector: i64) :i64 lib "pal"

// Check if stream is in error state. Returns 1 if error, 0 otherwise.
extern fn io_error: (selector: i64) :i64 lib "pal"

// Clear error and EOF indicators.
extern fn io_clear: (selector: i64) :i64 lib "pal"

// Get raw file descriptor for a stream.
extern fn io_fd: (selector: i64) :i64 lib "pal"

// Read one byte (or -1 at EOF).
extern fn io_read_char: () :i64 lib "pal"

// Read one line (without trailing newline).
extern fn io_read_line: () :str lib "pal"

// Read up to `count` bytes.
extern fn io_read_bytes: (count: i64) :str lib "pal"

// Read all remaining input.
extern fn io_read_all: () :str lib "pal"

// Bytes available for reading without blocking.
extern fn io_available: () :i64 lib "pal"

// Check if stdin is a TTY.
extern fn io_is_tty: () :i64 lib "pal"

// ── Time ───────────────────────────────────────────────────────────────────

// Monotonic clock in nanoseconds.
extern fn time_monotonic_ns: () :i64 lib "pal"

// ── Memory ─────────────────────────────────────────────────────────────────

// Allocate raw memory (bytes). Returns null on failure.
extern fn memory_alloc: (size: i64) :ptr lib "pal"

// Free raw memory allocated by memory_alloc.
extern fn memory_free: (ptr: ptr) lib "pal"

// Reallocate memory.
extern fn memory_realloc: (ptr: ptr, new_size: i64) :ptr lib "pal"

// Reserve virtual address space without committing physical pages.
// Returns null on failure.
extern fn memory_reserve: (size: i64) :ptr lib "pal"

// Release reserved virtual address space.
extern fn memory_release: (region: ptr, size: i64) :i64 lib "pal"

// ── Process ────────────────────────────────────────────────────────────────

// Execute a program. Returns 0 on success, -1 on failure.
extern fn proc_exec: (path: &str, args: &str) :i64 lib "pal"

// Spawn a child process. Returns PID on success, -1 on failure.
extern fn proc_spawn: (path: &str, args: &str) :i64 lib "pal"

// Wait for a process to exit. Returns exit code.
extern fn proc_wait: (pid: i64) :i64 lib "pal"

// ── Filesystem ─────────────────────────────────────────────────────────────

// Open a file. Returns a handle (ptr) or null on failure.
extern fn fs_open: (path: &str, flags: i64, mode: i64) :ptr lib "pal"

// Read from a file handle.
extern fn fs_read: (handle: ptr, buf: ptr, count: i64) :i64 lib "pal"

// Write to a file handle.
extern fn fs_write: (handle: ptr, data: ptr, count: i64) :i64 lib "pal"

// Close a file handle.
extern fn fs_close: (handle: ptr) :i64 lib "pal"

// Get file size.
extern fn fs_size: (handle: ptr) :i64 lib "pal"

// Seek within a file.
extern fn fs_seek: (handle: ptr, offset: i64, whence: i64) :i64 lib "pal"

// Get current position.
extern fn fs_tell: (handle: ptr) :i64 lib "pal"

// ── Threads ────────────────────────────────────────────────────────────────

// Create a new thread. Returns thread handle (ptr) or null.
extern fn thread_spawn: (entry: ptr, arg: ptr) :ptr lib "pal"

// Join a thread. Returns 0 on success.
extern fn thread_join: (handle: ptr, ret_ptr: ptr) :i64 lib "pal"

// ── Strings (managed) ──────────────────────────────────────────────────────

// Allocate a managed string of given byte length.
extern fn str_alloc: (len: i64) :str lib "pal"

// Create a managed string from a C string.
extern fn str_from_cstr: (cstr: ptr) :str lib "pal"

// Get length of a managed string.
extern fn str_len: (s: str) :i64 lib "pal"

// Retain a managed string (increment refcount).
extern fn str_retain: (s: str) lib "pal"

// Release a managed string (decrement refcount, free if zero).
extern fn str_release: (s: str) lib "pal"

// Check if a pointer is a managed string.
extern fn str_is_managed: (s: str) :i64 lib "pal"

// ── Math ───────────────────────────────────────────────────────────────────

// Absolute value for i64.
extern fn math_abs_i64: (x: i64) :i64 lib "pal"

// Absolute value for f64.
extern fn math_abs_f64: (x: f64) :f64 lib "pal"

// Square root for f64.
extern fn math_sqrt_f64: (x: f64) :f64 lib "pal"

// Power for f64.
extern fn math_pow_f64: (x: f64, y: f64) :f64 lib "pal"

// ── Process metrics ────────────────────────────────────────────────────────
 
 // Get process RSS in bytes.
 extern fn mem_process_rss: () :i64 lib "pal"
 
 // Get logical CPU count.
 extern fn cpu_count: () :i64 lib "pal"
 
 // ── Panic / Assert ─────────────────────────────────────────────────────────
 
 // Abort the process with a message and source location.
 extern fn panic_loc: (msg: str, line: i64, col: i64, file: str) lib "pal"
 
 // Assertion failure with message.
 extern fn assert_fail: (msg: str) lib "pal"

 // ── Bytes ──────────────────────────────────────────────────────────────────

 // Allocate raw memory (bytes). Returns null on failure.
 extern fn bytes_alloc: (size: i64) :ptr lib "pal"

 // Free raw memory allocated by bytes_alloc.
 extern fn bytes_free: (ptr: ptr) lib "pal"

 // Add delta to a pointer.
 extern fn ptr_add: (ptr: ptr, delta: i64) :ptr lib "pal"

 // Read u8/u16/u32/u64 from pointer.
 extern fn read_u8: (ptr: ptr) :i64 lib "pal"
 extern fn read_u16: (ptr: ptr) :i64 lib "pal"
 extern fn read_u32: (ptr: ptr) :i64 lib "pal"
 extern fn read_u64: (ptr: ptr) :i64 lib "pal"

 // Write u8/u16/u32/u64 to pointer.
 extern fn write_u8: (ptr: ptr, value: i64) lib "pal"
 extern fn write_u16: (ptr: ptr, value: i64) lib "pal"
 extern fn write_u32: (ptr: ptr, value: i64) lib "pal"
 extern fn write_u64: (ptr: ptr, value: i64) lib "pal"

 // Create managed string from slice.
 extern fn managed_from_slice: (src: ptr, len: i64) :str lib "pal"

 // Get length of managed string.
 extern fn managed_len: (value: &str) :i64 lib "pal"

// ── Maps ───────────────────────────────────────────────────────────────────
 
 // Get length of a map.
 extern fn map_len: (dict: ptr) :i64 lib "pal"
 
 // Check if map has a key.
 extern fn map_has: (dict: ptr, key: &str) :bool lib "pal"
 
 // Check if map is empty.
 extern fn map_is_empty: (dict: ptr) :bool lib "pal"
 
 // Get string value from map.
 extern fn map_get_str: (dict: ptr, key: &str) :str lib "pal"
 
 // Get i64 value from map.
 extern fn map_get_i64: (dict: ptr, key: &str) :i64 lib "pal"
 
 // Set string value in map.
 extern fn map_set_str: (dict: ptr, key: &str, value: &str) :ptr lib "pal"
 
 // Set i64 value in map.
 extern fn map_set_i64: (dict: ptr, key: &str, value: i64) :ptr lib "pal"
 
 // Remove a key from map.
 extern fn map_remove: (dict: ptr, key: &str) lib "pal"
 
 // Get all keys from map.
 extern fn map_keys: (dict: ptr) :ptr lib "pal"
 
 // Get all values from map.
 extern fn map_values: (dict: ptr) :ptr lib "pal"
 
 // Get all entries from map.
 extern fn map_entries: (dict: ptr) :i64 lib "pal"
 
 // Merge two maps.
 extern fn map_merge: (dict: ptr, other: ptr) :ptr lib "pal"
 
 // ── Arrays ──────────────────────────────────────────────────────────────────
 
 // Get length of an array.
 extern fn arr_len: (arr: ptr, count: i64) :i64 lib "pal"
 
 // Get first element of an array.
 extern fn arr_first_i64: (arr: ptr, count: i64, line: i64, col: i64, file: str) :i64 lib "pal"
 
 // Get last element of an array.
 extern fn arr_last_i64: (arr: ptr, count: i64, line: i64, col: i64, file: str) :i64 lib "pal"
 
 // Check if array contains a value.
 extern fn arr_contains_i64: (arr: ptr, count: i64, needle: i64) :bool lib "pal"
 
 // Find index of a value in array.
 extern fn arr_index_of_i64: (arr: ptr, count: i64, needle: i64) :i64 lib "pal"
 
 // Reverse an array in place.
 extern fn arr_reverse_i64: (arr: ptr, count: i64) lib "pal"
 
 // Join array elements with separator.
 extern fn arr_join: (arr: ptr, count: i64, sep: ptr) :ptr lib "pal"
 
 // ── Result ───────────────────────────────────────────────────────────────────
 
 // Create Ok result with i64 value.
 extern fn result_ok_i64: (value: i64) :ptr lib "pal"
 
 // Create Ok result with string value.
 extern fn result_ok_str: (value: str) :ptr lib "pal"
 
 // Create Ok result with pointer value.
 extern fn result_ok_ptr: (value: ptr) :ptr lib "pal"
 
 // Create Err result with i64 error.
 extern fn result_err_i64: (error: i64) :ptr lib "pal"
 
 // Create Err result with string error.
 extern fn result_err_str: (error: str) :ptr lib "pal"
 
 // Create Err result with pointer error.
 extern fn result_err_ptr: (error: ptr) :ptr lib "pal"
 
 // Check if result is Ok.
 extern fn result_is_ok: (ptr: ptr) :bool lib "pal"
 
 // Check if result is Err.
 extern fn result_is_err: (ptr: ptr) :bool lib "pal"
 
 // Get error payload from Err result.
 extern fn result_err_payload: (ptr: ptr) :ptr lib "pal"
 
 // Unwrap i64 from Ok result (panics on Err).
 extern fn result_unwrap_i64: (ptr: ptr, line: i64, col: i64, file: str) :i64 lib "pal"
 
 // Unwrap string from Ok result (panics on Err).
 extern fn result_unwrap_str: (ptr: ptr, line: i64, col: i64, file: str) :ptr lib "pal"
 
 // Unwrap f64 from Ok result (panics on Err).
 extern fn result_unwrap_f64: (ptr: ptr, line: i64, col: i64, file: str) :f64 lib "pal"
 
 // Unwrap pointer from Ok result (panics on Err).
 extern fn result_unwrap_ptr: (ptr: ptr, line: i64, col: i64, file: str) :ptr lib "pal"
 
 // Unwrap error string from Err result (panics on Ok).
 extern fn result_unwrap_err_str: (ptr: ptr, line: i64, col: i64, file: str) :ptr lib "pal"
 
 // Unwrap Or: get value or default for i64.
 extern fn result_unwrap_or_i64: (ptr: ptr, default_val: i64) :i64 lib "pal"
 
 // Unwrap Or: get value or default for string.
 extern fn result_unwrap_or_str: (ptr: ptr, default_val: ptr) :ptr lib "pal"
 
 // Unwrap Or: get value or default for f64.
 extern fn result_unwrap_or_f64: (ptr: ptr, default_val: f64) :f64 lib "pal"
 
 // Unwrap Or: get value or default for pointer.
 extern fn result_unwrap_or_ptr: (ptr: ptr, default_val: ptr) :ptr lib "pal"
 
 // Free a result.
 extern fn result_free: (ptr: ptr) lib "pal"
 
 // ── Maybe ───────────────────────────────────────────────────────────────────
 
 // Create Some with i64 value.
 extern fn maybe_some_i64: (value: i64) :ptr lib "pal"
 
 // Create Some with string value.
 extern fn maybe_some_str: (value: str) :ptr lib "pal"
 
 // Create Some with f64 value.
 extern fn maybe_some_f64: (value: f64) :ptr lib "pal"
 
 // Create Some with pointer value.
 extern fn maybe_some_ptr: (value: ptr) :ptr lib "pal"
 
 // Create None value.
 extern fn maybe_none_as_ptr: () :ptr lib "pal"
 
 // Check if Maybe is None.
 extern fn maybe_is_none: (ptr: ptr) :bool lib "pal"
 
 // Check if Maybe is Some.
 extern fn maybe_is_some: (ptr: ptr) :bool lib "pal"
 
 // Unwrap i64 from Some (panics on None).
 extern fn maybe_unwrap_i64: (ptr: ptr, line: i64, col: i64, file: str) :i64 lib "pal"
 
 // Unwrap string from Some (panics on None).
 extern fn maybe_unwrap_str: (ptr: ptr, line: i64, col: i64, file: str) :ptr lib "pal"
 
 // Unwrap f64 from Some (panics on None).
 extern fn maybe_unwrap_f64: (ptr: ptr, line: i64, col: i64, file: str) :f64 lib "pal"
 
 // Unwrap pointer from Some (panics on None).
 extern fn maybe_unwrap_ptr: (ptr: ptr, line: i64, col: i64, file: str) :ptr lib "pal"
 
 // Unwrap Or: get value or default for i64.
 extern fn maybe_unwrap_or_i64: (ptr: ptr, default_val: i64) :i64 lib "pal"
 
 // Unwrap Or: get value or default for string.
 extern fn maybe_unwrap_or_str: (ptr: ptr, default_val: ptr) :ptr lib "pal"
 
 // Unwrap Or: get value or default for f64.
 extern fn maybe_unwrap_or_f64: (ptr: ptr, default_val: f64) :f64 lib "pal"
 
 // Unwrap Or: get value or default for pointer.
 extern fn maybe_unwrap_or_ptr: (ptr: ptr, default_val: ptr) :ptr lib "pal"
 
// Free a Maybe.
extern fn maybe_free: (ptr: ptr) lib "pal"

// ── Bump allocator free list ──────────────────────────────────────────────
// Find a free block of at least the given size. Returns size class index or -1.
extern fn bump_free_list_find: (size: i64) :i64 lib "pal"

// Pop a block from the free list. Returns the block pointer or null.
extern fn bump_free_list_pop: (size_class: i64) :ptr lib "pal"

/// Push a block back to the free list.
extern fn bump_free_list_push: (ptr: ptr, size_class: i64) lib "pal"

/// Initialize the bump allocator free list (called at startup).
extern fn bump_free_list_init: () lib "pal"