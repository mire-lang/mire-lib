module str

// String operations using PAL for memory management.
// String operations are implemented in the Mire runtime C code and exposed
// via PAL-compatible externs.
// TODO: Move string operations to PAL C library for full C independence.

// ── Runtime externs (via PAL) ────────────────────────────────────────────
extern fn rt_strings_len: (s :&str) :i64 lib "pal"
extern fn rt_strings_to_upper: (s :&str) :str lib "pal"
extern fn rt_strings_to_lower: (s :&str) :str lib "pal"
extern fn rt_strings_trim: (s :&str) :str lib "pal"
extern fn rt_strings_strip: (s :&str) :str lib "pal"
extern fn rt_strings_contains: (s :&str, sub :&str) :bool lib "pal"
extern fn rt_strings_starts_with: (s :&str, prefix :&str) :bool lib "pal"
extern fn rt_strings_ends_with: (s :&str, suffix :&str) :bool lib "pal"
extern fn rt_strings_index_of: (s :&str, sub :&str) :i64 lib "pal"
extern fn rt_strings_replace: (s :&str, old :&str, new :&str) :str lib "pal"
extern fn rt_strings_replace_first: (s :&str, old :&str, new :&str) :str lib "pal"
extern fn rt_strings_split: (s :&str, sep :&str) :vec[str] lib "pal"
extern fn rt_strings_join_list: (parts :&vec[str], sep :&str) :str lib "pal"
extern fn rt_strings_substr: (s :&str, start :i64, len :i64) :str lib "pal"
extern fn rt_strings_repeat: (s :&str, n :i64) :str lib "pal"
extern fn rt_strings_pad_left: (s :&str, total_len :i64, pad :&str) :str lib "pal"
extern fn rt_strings_pad_right: (s :&str, total_len :i64, pad :&str) :str lib "pal"
extern fn rt_i64_to_string: (value :i64) :str lib "pal"
extern fn rt_string_to_i64: (s :&str) :i64 lib "pal"
extern fn rt_bool_to_string: (value :i64) :str lib "pal"
extern fn rt_f64_to_string: (value :f64) :str lib "pal"
extern fn rt_string_concat: (left :&str, right :&str) :str lib "pal"
extern fn rt_string_copy: (value :&str) :str lib "pal"

// ── len ─────────────────────────────────────────────────────────
pub fn len: (s :&str) :i64 { return rt_strings_len(s) }

// ── upper / lower ───────────────────────────────────────────────
pub fn upper: (s :&str) :str { return rt_strings_to_upper(s) }
pub fn lower: (s :&str) :str { return rt_strings_to_lower(s) }

// ── trim ────────────────────────────────────────────────────────
pub fn trim: (s :&str) :str { return rt_strings_trim(s) }
pub fn strip: (s :&str) :str { return rt_strings_strip(s) }

// ── contains ────────────────────────────────────────────────────
pub fn contains: (s :&str, sub :&str) :bool { return rt_strings_contains(s, sub) }

// ── starts ──────────────────────────────────────────────────────
pub fn starts: () {
    pub fn with: (s :&str, prefix :&str) :bool { return rt_strings_starts_with(s, prefix) }
}

// ── ends ────────────────────────────────────────────────────────
pub fn ends: () {
    pub fn with: (s :&str, suffix :&str) :bool { return rt_strings_ends_with(s, suffix) }
}

// ── index ───────────────────────────────────────────────────────
pub fn index: (s :&str, sub :&str) :i64 { return rt_strings_index_of(s, sub) }

// ── replace ─────────────────────────────────────────────────────
pub fn replace: (s :&str, old :&str, new :&str) :str { return rt_strings_replace(s, old, new) }
pub fn replace::first: (s :&str, old :&str, new :&str) :str { return rt_strings_replace_first(s, old, new) }

// ── split / join ────────────────────────────────────────────────
pub fn split: (s :&str, sep :&str) :vec[str] { return rt_strings_split(s, sep) }
pub fn join: (parts :&vec[str], sep :&str) :str { return rt_strings_join_list(parts, sep) }

// ── substr ──────────────────────────────────────────────────────
pub fn substr: (s :&str, start :i64, len :i64) :str { return rt_strings_substr(s, start, len) }

// ── repeat ──────────────────────────────────────────────────────
pub fn repeat: (s :&str, n :i64) :str { return rt_strings_repeat(s, n) }

// ── pad ─────────────────────────────────────────────────────────
pub fn pad: () {
    pub fn left: (s :&str, total_len :i64, pad :&str) :str { return rt_strings_pad_left(s, total_len, pad) }
    pub fn right: (s :&str, total_len :i64, pad :&str) :str { return rt_strings_pad_right(s, total_len, pad) }
}

// ── from ────────────────────────────────────────────────────────
pub fn from: () {
    pub fn i64: (n :i64) :str { return rt_i64_to_string(n) }
    pub fn bool: (b :bool) :str { return rt_bool_to_string(if b { 1 } else { 0 }) }
    pub fn f64: (v :f64) :str { return rt_f64_to_string(v) }
}

// ── to ──────────────────────────────────────────────────────────
pub fn to: () {
    pub fn i64: (s :&str) :i64 { return rt_string_to_i64(copy(s)) }
}

// ── concat / copy ───────────────────────────────────────────────
pub fn concat: (left :&str, right :&str) :str { return rt_string_concat(left, right) }
pub fn copy: (s :&str) :str { return rt_string_copy(s) }

// ── is ──────────────────────────────────────────────────────────
pub fn is: () {
    pub fn empty: (s :&str) :bool { return rt_strings_len(s) == 0 }
}