module arr

// ── C runtime ───────────────────────────────────────────────────
extern fn rt_arr_len: (arr :ptr, count :i64) :i64 lib "c"
extern fn rt_arr_first_i64: (arr :ptr, count :i64, line :i64, col :i64, file :ptr) :i64 lib "c"
extern fn rt_arr_last_i64: (arr :ptr, count :i64, line :i64, col :i64, file :ptr) :i64 lib "c"
extern fn rt_arr_contains_i64: (arr :ptr, count :i64, needle :i64) :bool lib "c"
extern fn rt_arr_index_of_i64: (arr :ptr, count :i64, needle :i64) :i64 lib "c"
extern fn rt_arr_reverse_i64: (arr :ptr, count :i64) lib "c"
extern fn rt_arr_join: (arr :ptr, count :i64, sep :ptr) :ptr lib "c"

// ── len ─────────────────────────────────────────────────────────
pub fn len: (arr :ptr, count :i64) :i64 { return rt_arr_len(arr, count) }

// ── first ───────────────────────────────────────────────────────
pub fn first: () {
    pub fn i64: (arr :ptr, count :i64) :i64 { return rt_arr_first_i64(arr, count, 0, 0, "") }
}

// ── last ────────────────────────────────────────────────────────
pub fn last: () {
    pub fn i64: (arr :ptr, count :i64) :i64 { return rt_arr_last_i64(arr, count, 0, 0, "") }
}

// ── contains ────────────────────────────────────────────────────
pub fn contains: () {
    pub fn i64: (arr :ptr, count :i64, needle :i64) :bool { return rt_arr_contains_i64(arr, count, needle) }
}

// ── index ───────────────────────────────────────────────────────
pub fn index: () {
    pub fn i64: (arr :ptr, count :i64, needle :i64) :i64 { return rt_arr_index_of_i64(arr, count, needle) }
}

// ── reverse ─────────────────────────────────────────────────────
pub fn reverse: () {
    pub fn i64: (arr :ptr, count :i64) { rt_arr_reverse_i64(arr, count) }
}

// ── join ────────────────────────────────────────────────────────
pub fn join: (arr :ptr, count :i64, sep :ptr) :ptr { return rt_arr_join(arr, count, sep) }
