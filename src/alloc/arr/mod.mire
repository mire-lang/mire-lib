module arr

// ── PAL array operations ───────────────────────────────────────────────────
load mire::aux::pal

// ── len ─────────────────────────────────────────────────────────
pub fn len: (arr :ptr, count :i64) :i64 { return pal::arr_len(arr, count) }

// ── first ───────────────────────────────────────────────────────
pub fn first: () {
    pub fn i64: (arr :ptr, count :i64) :i64 { return pal::arr_first_i64(arr, count, 0, 0, "") }
}

// ── last ────────────────────────────────────────────────────────
pub fn last: () {
    pub fn i64: (arr :ptr, count :i64) :i64 { return pal::arr_last_i64(arr, count, 0, 0, "") }
}

// ── contains ────────────────────────────────────────────────────
pub fn contains: () {
    pub fn i64: (arr :ptr, count :i64, needle :i64) :bool { return pal::arr_contains_i64(arr, count, needle) }
}

// ── index ───────────────────────────────────────────────────────
pub fn index: () {
    pub fn i64: (arr :ptr, count :i64, needle :i64) :i64 { return pal::arr_index_of_i64(arr, count, needle) }
}

// ── reverse ─────────────────────────────────────────────────────
pub fn reverse: () {
    pub fn i64: (arr :ptr, count :i64) { pal::arr_reverse_i64(arr, count) }
}

// ── join ────────────────────────────────────────────────────────
pub fn join: (arr :ptr, count :i64, sep :ptr) :ptr { return pal::arr_join(arr, count, sep) }