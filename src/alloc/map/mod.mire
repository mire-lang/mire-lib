module map

// ── PAL map operations ─────────────────────────────────────────────────────
load mire::aux::pal

// ── len ─────────────────────────────────────────────────────────
pub fn len: (m :&anything) :i64 { return pal::map_len(m) }

// ── has ─────────────────────────────────────────────────────────
pub fn has: (m :&anything, key :&str) :bool { return pal::map_has(m, key) }

// ── is ──────────────────────────────────────────────────────────
pub fn is: () {
    pub fn empty: (m :&anything) :bool { return pal::map_is_empty(m) }
}

// ── get ─────────────────────────────────────────────────────────
// `get::i64` calls the flat single-function probe for the common
// `map[str i64]` shape. The generic runtime path is a chain of small
// tcc-compiled helpers (public API -> dict -> hash key -> hash string ->
// string length -> managed check, then the probe -> key equals -> two more
// lengths), and every call shows up in the two-million-lookup map benchmark.
// The flat function keeps the same table layout and hash but collapses the
// chain into one call; other key/value shapes fall back inside it.
extern fn rt_maps_get_i64_fast: (dict :ptr, key :&str) :i64 lib "pal"

pub fn get: () {
    pub fn str: (m :&anything, key :&str) :str { return pal::map_get_str(m, key) }
    pub fn i64: (m :&anything, key :&str) :i64 {
        return rt_maps_get_i64_fast(m, key)
    }
}

// ── set ─────────────────────────────────────────────────────────
pub fn set: () {
    pub fn str: (m :ptr, key :&str, value :str) :ptr { return pal::map_set_str(m, key, value) }
    pub fn i64: (m :ptr, key :&str, value :i64) :ptr { return pal::map_set_i64(m, key, value) }
}

// ── remove ──────────────────────────────────────────────────────
pub fn remove: (m :ptr, key :&str) { pal::map_remove(m, key) }

// ── keys ────────────────────────────────────────────────────────
pub fn keys: (m :ptr) :ptr { return pal::map_keys(m) }

// ── values ──────────────────────────────────────────────────────
pub fn values: () {
    pub fn i64: (m :ptr) :ptr { return pal::map_values(m) }
}

// ── entries ─────────────────────────────────────────────────────
pub fn entries: (m :ptr) :i64 { return pal::map_entries(m) }

// ── merge ───────────────────────────────────────────────────────
pub fn merge: (m :ptr, other :ptr) :ptr { return pal::map_merge(m, other) }