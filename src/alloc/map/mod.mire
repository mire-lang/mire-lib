module map

// ── PAL map operations ─────────────────────────────────────────────────────
load mire::aux::pal

// ── len ─────────────────────────────────────────────────────────
pub fn len: (m :&anything) :i64 { return pal::map_len(m) }

// ── has ─────────────────────────────────────────────────────────
pub fn has: (m :&anything, key :&str) :bool { return pal::map_has(m, key) }

// ── is ──────────────────────────────────────────────────────────
pub fn is: () {
    pub fn empty: (m :&anything) :bool { return pal::map_is_empty(m) }
}

// ── get ─────────────────────────────────────────────────────────
pub fn get: () {
    pub fn str: (m :&anything, key :&str) :str { return pal::map_get_str(m, key) }
    pub fn i64: (m :&anything, key :&str) :i64 { return pal::map_get_i64(m, key) }
}

// ── set ─────────────────────────────────────────────────────────
pub fn set: () {
    pub fn str: (m :ptr, key :&str, value :&str) :ptr { return pal::map_set_str(m, key, value) }
    pub fn i64: (m :ptr, key :&str, value :i64) :ptr { return pal::map_set_i64(m, key, value) }
}

// ── remove ──────────────────────────────────────────────────────
pub fn remove: (m :ptr, key :&str) { pal::map_remove(m, key) }

// ── keys ────────────────────────────────────────────────────────
pub fn keys: (m :ptr) :ptr { return pal::map_keys(m) }

// ── values ──────────────────────────────────────────────────────
pub fn values: () {
    pub fn i64: (m :ptr) :ptr { return pal::map_values(m) }
}

// ── entries ─────────────────────────────────────────────────────
pub fn entries: (m :ptr) :i64 { return pal::map_entries(m) }

// ── merge ───────────────────────────────────────────────────────
pub fn merge: (m :ptr, other :ptr) :ptr { return pal::map_merge(m, other) }