load mire::std
load mire::str

// Tests for mire::std.
//
// The stream functions write to the real stdout and stderr, so these tests
// assert on the return values (byte counts, error state, fd numbers) rather than
// on captured text: a test harness that captured its own output would be testing
// the harness. The read tests run against stdin, which under `mire test` is the
// terminal or /dev/null, so they assert on the shape of the answer (lengths and
// sentinel values) instead of on specific input.
//
// What these cover: that the module resolves and links, that each write reports
// the byte count it actually wrote, that both output streams are independently
// addressable, and that reads distinguish end of input from data.

// ── out ────────────────────────────────────────────────────────────────────

@[test] pub fn out_write_reports_byte_count: () :bool {
    // "abc" is three bytes; a bare write adds nothing.
    return out::write_n("abc" 3) == 3
}

@[test] pub fn out_write_n_respects_count: () :bool {
    // A shorter count than the string length writes only the prefix.
    return out::write_n("abcdef" 2) == 2
}

@[test] pub fn out_write_n_survives_empty: () :bool {
    // Writing zero bytes is not an error.
    return out::write_n("abc" 0) == 0
}

@[test] pub fn out_print_i64_reports_length: () :bool {
    // 42 is two digits plus the newline the runtime appends.
    return out::print_i64(42) == 3
}

@[test] pub fn out_print_i64_handles_negative: () :bool {
    // -7 is two characters, so two plus the newline.
    return out::print_i64(-7) == 3
}

@[test] pub fn out_print_i64_handles_min: () :bool {
    // The extreme value must still format rather than overflow the buffer.
    set n = out::print_i64_no_newline(-9223372036854775807)
    return n > 0
}

@[test] pub fn out_flush_succeeds: () :bool {
    return out::flush() == 0
}

@[test] pub fn out_starts_without_error: () :bool {
    return out::failed() == false
}

@[test] pub fn out_fd_is_stdout: () :bool {
    // Descriptor 1 is stdout on every platform this runs on.
    return out::fd() == 1
}

// ── err ────────────────────────────────────────────────────────────────────

@[test] pub fn err_write_reports_byte_count: () :bool {
    return err::write_n("abc" 3) == 3
}

@[test] pub fn err_write_n_respects_count: () :bool {
    return err::write_n("abcdef" 2) == 2
}

@[test] pub fn err_print_i64_reports_length: () :bool {
    return err::print_i64(42) == 3
}

@[test] pub fn err_fd_is_stderr: () :bool {
    // Descriptor 2 is stderr. This is also what proves err:: and out:: are bound
    // to different streams rather than both aliasing stdout.
    return err::fd() == 2
}

@[test] pub fn err_and_out_have_distinct_fds: () :bool {
    return out::fd() != err::fd()
}

@[test] pub fn err_flush_succeeds: () :bool {
    return err::flush() == 0
}

@[test] pub fn err_starts_without_error: () :bool {
    return err::failed() == false
}

// ── input ──────────────────────────────────────────────────────────────────

@[test] pub fn in_all_on_empty_input_is_empty: () :bool {
    // Whatever stdin holds, reading it to the end must terminate. Under `mire
    // test` this is normally /dev/null, so the result is the empty string; the
    // point is that the call returns at all rather than blocking or erroring.
    set rest = in::all()
    return str::len(rest) >= 0
}

@[test] pub fn in_bytes_zero_reads_nothing: () :bool {
    set nothing = in::bytes(0)
    return str::len(nothing) == 0
}

@[test] pub fn in_line_returns_a_managed_string: () :bool {
    set l = in::line()
    return str::len(l) >= 0
}

@[test] pub fn in_available_is_never_negative: () :bool {
    // 0 means nothing is ready. Negative would mean the poll failed, which the
    // runtime never reports, so this also pins that contract.
    return in::available() >= 0
}

@[test] pub fn in_is_tty_is_false_under_test: () :bool {
    // `mire test` does not attach a terminal to the test binary, so this must be
    // false. It is the check that a program can branch on "am I interactive".
    return in::is_tty() == false
}

@[test] pub fn in_byte_after_drain_is_eof: () :bool {
    // Drain stdin, then the next single-byte read must report end of input with
    // -1 rather than 0, so a binary protocol can tell EOF from a NUL byte.
    set rest = in::all()
    return in::byte() == -1
}

// ── flat aliases on the parent module ──────────────────────────────────────

@[test] pub fn flat_flush_succeeds: () :bool {
    // std::flush drives both output streams, so it is expected to succeed even
    // when neither out:: nor err:: has been touched directly.
    return std::flush() == 0
}

@[test] pub fn flat_available_matches_stream: () :bool {
    return std::available() >= 0
}

@[test] pub fn flat_is_tty_matches_stream: () :bool {
    return std::is_tty() == in::is_tty()
}

@[test] pub fn flat_read_byte_is_eof_after_drain: () :bool {
    set rest = std::read_all()
    return std::read_byte() == -1
}
