module input

// Standard input.
//
// Reads are binary safe. They copy a byte count and never stop at a NUL, so a
// payload piped in from another process arrives byte for byte. The read
// functions return a managed string, so str::len reports how many bytes actually
// arrived — that is how a short read at end of input is detected rather than
// guessed from a sentinel.
//
// Reads go through the C stdio stream for the same reason the writers do: mixing
// a buffered FILE* with raw read(2) on the same descriptor loses whatever one of
// them has already buffered. That also means a read here and an ireru prompt see
// the same stream position.

// ── C runtime ─────────────────────────────────────────────────────────────
extern fn rt_io_read_char: () :i64 lib "c"
extern fn rt_io_read_line: () :str lib "c"
extern fn rt_io_read_bytes: (count :i64) :str lib "c"
extern fn rt_io_read_all: () :str lib "c"
extern fn rt_io_available: () :i64 lib "c"
extern fn rt_io_is_tty: () :i64 lib "c"

// ── lines and bytes ────────────────────────────────────────────────────────

// Read one line and return it with the trailing newline removed. A CRLF pair
// loses its CR too, so input from any platform reads the same. Returns an empty
// string at end of input, so an empty line and end of input are told apart with
// available() or by attempting a second read.
pub fn line: () :str { return rt_io_read_line() }

// Read one byte. Returns 0..255, or -1 at end of input. This is the only read
// that reports EOF as a distinct value rather than as an empty string, so it is
// the right choice for a binary protocol.
pub fn byte: () :i64 { return rt_io_read_char() }

// Read up to `count` bytes, or fewer if the input ends first. Use str::len on
// the result to learn how many arrived. Embedded NULs are preserved.
pub fn bytes: (count :i64) :str { return rt_io_read_bytes(count) }

// Read stdin to end of input and return it as a managed string. Binary safe.
// Returns an empty string when stdin is already at end of input.
pub fn all: () :str { return rt_io_read_all() }

// ── readiness ──────────────────────────────────────────────────────────────

// Bytes waiting on stdin without blocking, or 0 when nothing is ready. A prompt
// that should not block uses this to decide between asking and moving on, and it
// never consumes input, so a later read still sees everything.
pub fn available: () :i64 { return rt_io_available() }

// True when stdin is an interactive terminal. Piped input is not, which is how a
// program tells "a human is typing" from "another process is feeding me".
pub fn is_tty: () :bool { return rt_io_is_tty() == 1 }
