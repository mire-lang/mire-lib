module err

// Standard error.
//
// Everything goes through the C stdio stream for stderr and is flushed on every
// call, so a prompt appears immediately even when stdout is a pipe rather than a
// terminal, and a program that writes a lot does not lose a partial line on exit.
//
// Writes are binary safe: they copy a byte count and never stop at a NUL, so a
// payload read from a file can be echoed back unchanged. Each write returns the
// number of bytes written, or -1 if the stream rejected it.
//
// NOTE ON THE `sel` LOCAL: the selector is bound to a local rather than passed as
// a literal at every call site. That is a workaround for a compiler bug in which
// two functions whose bodies differ only in a constant argument collapse into a
// single emitted definition, leaving the other one referenced but never defined
// ("use of undefined value"). Binding the selector keeps each body distinct. It
// also documents which stream is meant at every call, which is worth having
// anyway. Tracked upstream; safe to inline away once it is fixed.

// ── C runtime ─────────────────────────────────────────────────────────────
extern fn rt_io_write: (selector :i64, data :&str) :i64 lib "c"
extern fn rt_io_write_n: (selector :i64, data :&str, count :i64) :i64 lib "c"
extern fn rt_io_write_line: (selector :i64, data :&str) :i64 lib "c"
extern fn rt_io_write_i64: (selector :i64, value :i64, newline :i64) :i64 lib "c"
extern fn rt_io_write_f64: (selector :i64, value :f64, newline :i64) :i64 lib "c"
extern fn rt_io_flush: (selector :i64) :i64 lib "c"
extern fn rt_io_error: (selector :i64) :i64 lib "c"
extern fn rt_io_clear: (selector :i64) :i64 lib "c"
extern fn rt_io_fd: (selector :i64) :i64 lib "c"

// ── text ───────────────────────────────────────────────────────────────────

// Write text with no trailing newline. Returns the byte count written.
pub fn print: (s :&str) :i64 {
    set sel = 2
    return rt_io_write(sel s)
}

// Write text followed by a newline, as a single write so the line cannot be
// split across two flushes by another writer.
pub fn println: (s :&str) :i64 {
    set sel = 2
    return rt_io_write_line(sel s)
}

// Write at most `count` bytes of text, for a payload that carries a separate
// length. Embedded NULs are written as ordinary bytes.
pub fn write_n: (s :&str, count :i64) :i64 {
    set sel = 2
    return rt_io_write_n(sel s count)
}

// ── numbers ────────────────────────────────────────────────────────────────

// Write an integer with no trailing newline. Formatted natively by the runtime,
// so printing a number never allocates a string.
pub fn print_i64_no_newline: (value :i64) :i64 {
    set sel = 2
    return rt_io_write_i64(sel value 0)
}

// Write an integer followed by a newline.
pub fn print_i64: (value :i64) :i64 {
    set sel = 2
    return rt_io_write_i64(sel value 1)
}

// Write a float followed by a newline, using the shortest representation that
// round-trips. That is the right default for diagnostics.
pub fn print_f64: (value :f64) :i64 {
    set sel = 2
    return rt_io_write_f64(sel value 1)
}

// ── stream state ───────────────────────────────────────────────────────────

// Flush buffered output. Returns 0 on success.
pub fn flush: () :i64 {
    set sel = 2
    return rt_io_flush(sel)
}

// True when an earlier write failed, i.e. the stream is in an error state.
pub fn failed: () :bool {
    set sel = 2
    return rt_io_error(sel) == 1
}

// Clear the error and end-of-file indicators so the stream can be reused.
pub fn clear: () :i64 {
    set sel = 2
    return rt_io_clear(sel)
}

// The raw descriptor behind stderr, for handing to something that needs an fd
// rather than a stream, such as wiring a child process's output.
pub fn fd: () :i64 {
    set sel = 2
    return rt_io_fd(sel)
}
